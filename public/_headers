# Cloudflare Pages headers. OG images are exported without a file
# extension, so set their MIME explicitly for social scrapers.
/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=3600

/*/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=3600

# Registry JSON is fetched cross-origin by installers and web playgrounds.
/r/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

# AI-agent discovery file.
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

# Immutable hashed build assets.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
