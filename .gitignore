# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Wrangler local secrets
.dev.vars

# Wrangler local state
.wrangler/

# Local agent worktrees
.claude/
/dist/

# Velora Pro source: a clone of the private ColorlibHQ/velora-pro repo.
# The site builds without it (free blocks only).
/pro/

# Generated by scripts/build-docs.mjs (predev/prebuild); they list Pro blocks when pro/ exists
/src/lib/blocks-meta.json
/src/content/blocks-index.ts
